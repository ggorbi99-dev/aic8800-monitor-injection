diff --git a/drivers/aic8800/aic8800_fdrv/rwnx_tx.c b/drivers/aic8800/aic8800_fdrv/rwnx_tx.c
index 9030899..7fe520a 100644
--- a/drivers/aic8800/aic8800_fdrv/rwnx_tx.c
+++ b/drivers/aic8800/aic8800_fdrv/rwnx_tx.c
@@ -675,6 +675,10 @@ void rwnx_tx_push(struct rwnx_hw *rwnx_hw, struct rwnx_txhdr *txhdr, int flags)
 	((*(skb->data+sw_txhdr->headroom)==0xd0) || (*(skb->data+sw_txhdr->headroom)==0x10) || (*(skb->data+sw_txhdr->headroom)==0x30))) || \
         (sw_txhdr->desc.host.ethertype == 0x8e88) || (sw_txhdr->desc.host.ethertype == 0xb488)) {
 	// 0xd0:Action, 0x10:AssocRsp, 0x8e88:EAPOL, 0xb488: WAPI
+	// raw_frame: vom Monitor-Interface injizierte Frames MUESSEN den
+	// Bestaetigungs-Ring (Bit 31) benutzen. Der fixed_rate-Pfad (Bit 30)
+	// wird von der D80-Firmware stillschweigend verworfen, weshalb
+	// Beacons/Probe-Requests sonst nie in die Luft gehen.
         sw_txhdr->need_cfm = 1;
         sw_txhdr->desc.host.status_desc_addr = ((1<<31) | rwnx_hw->usb_env.txdesc_free_idx[0]);
         aicwf_usb_host_txdesc_push(&(rwnx_hw->usb_env), 0, (long)(skb));
@@ -705,6 +709,8 @@ void rwnx_tx_push(struct rwnx_hw *rwnx_hw, struct rwnx_txhdr *txhdr, int flags)
         sw_txhdr->rwnx_vif->net_stats.tx_bytes += sw_txhdr->frame_len;
         rwnx_hw->stats.last_tx = jiffies;
     }
+    printk("AICMON: push need_cfm=%d status_addr=0x%x\n",
+           sw_txhdr->need_cfm, sw_txhdr->desc.host.status_desc_addr);
     aicwf_frame_tx((void *)(rwnx_hw->usbdev), skb);
 #endif
 #endif
@@ -2341,8 +2347,18 @@ netdev_tx_t rwnx_start_monitor_if_xmit(struct sk_buff *skb, struct net_device *d
 
     spin_lock_bh(&rwnx_hw->tx_lock);
     AICWFDBG(LOGTRACE, "%s send data\r\n", __func__);
-    if (rwnx_txq_queue_skb(skb_mgmt, txq, rwnx_hw, false))
-        rwnx_hwq_process(rwnx_hw, txq->hwq);
+    {
+        bool queued = rwnx_txq_queue_skb(skb_mgmt, txq, rwnx_hw, false);
+        printk("AICMON: queue txq_idx=%d hwq=%d sta=%s staid=%d vif=%d flags=0x%x rate=0x%x fc=0x%02x queued=%d\n",
+               txq->idx, txq->hwq->id,
+               sta ? "yes" : "no",
+               desc->host.staid, desc->host.vif_idx,
+               desc->host.flags, sw_txhdr->rate_config,
+               (unsigned char)*(skb_mgmt->data + sizeof(struct rwnx_txhdr)),
+               (int)queued);
+        if (queued)
+            rwnx_hwq_process(rwnx_hw, txq->hwq);
+    }
     spin_unlock_bh(&rwnx_hw->tx_lock);
 
 free_tag:
@@ -2408,6 +2424,10 @@ int rwnx_txdatacfm(void *pthis, void *host_id)
 
     /* Update txq and HW queue credits */
     if (sw_txhdr->desc.host.flags & TXU_CNTRL_MGMT) {
+        printk("AICMON: cfm raw=%d st=0x%x done=%d retry=%d swretry=%d acked=%d\n",
+               sw_txhdr->raw_frame, txhdr->hw_hdr.cfm.status.value,
+               rwnx_txst.tx_done, rwnx_txst.retry_required,
+               rwnx_txst.sw_retry_required, rwnx_txst.acknowledged);
         trace_printk("done=%d retry_required=%d sw_retry_required=%d acknowledged=%d\n",
                      rwnx_txst.tx_done, rwnx_txst.retry_required,
                      rwnx_txst.sw_retry_required, rwnx_txst.acknowledged);
